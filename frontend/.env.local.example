# Backend API URL (no trailing slash)
# Used by the browser, so it must be reachable from the visitor's network,
# not just from the machine running the Next.js server.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Public origin of this site (no trailing slash).
# Only used to build absolute Open Graph and Twitter image URLs. Set it to the
# real domain before deploying, otherwise social previews resolve to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
